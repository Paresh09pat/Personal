# Copy to .env and adjust. Every variable is documented in docs/ENV.md.
# For local development you need NONE of these — `npm run dev` just works.

# ── Core ────────────────────────────────────────────────────────────────
# NODE_ENV=production
# PORT=3000
# APP_ORIGIN=https://our-little-world.example.com

# ── Database (required in production; e.g. MongoDB Atlas free M0) ───────
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ── Secrets (required in production; 32+ random chars each) ─────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=
# MEDIA_SIGNING_SECRET=

# ── Who can sign up: open | invite_only (default invite_only in production)
# REGISTRATION_MODE=invite_only

# ── Private media storage: local (needs a persistent disk) | s3 ────────
# STORAGE_DRIVER=local
# UPLOAD_DIR=.data/uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ── Email (optional; links are printed to the console when unset) ──────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Our Little World <you@example.com>"
# EMAIL_VERIFICATION=auto

# ── Calls (optional TURN for strict mobile/corporate networks) ─────────
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ── Proxy / misc ────────────────────────────────────────────────────────
# TRUST_PROXY=1
# INVITE_TTL_HOURS=72
